# Required for Caddy HTTPS. Point this domain's DNS at your VPS.
DOMAIN=share.example.com
ACME_EMAIL=you@example.com

# Optional TURN relay: run setup-turn.sh PUBLIC_IP PRIVATE_IP to populate these.
# Start with: docker compose -f compose.yaml -f compose.turn.yaml up -d
# TURN_PUBLIC_IP=
# TURN_PRIVATE_IP=
# TURN_SECRET=
# STREAMROOM_ICE_POLICY=relay

# Direct Node.js only (Compose sets its own internal bind address):
# STREAMROOM_BIND=127.0.0.1:8787
# STREAMROOM_CERT=/path/to/fullchain.pem
# STREAMROOM_KEY=/path/to/privkey.pem
